# ==========================================
# CẤU HÌNH BOT DISCORD & GOOGLE AI
# ==========================================

# Token của Discord Bot (Lấy từ Discord Developer Portal -> Bot -> Token)
DISCORD_TOKEN=your_discord_bot_token_here

# Client ID của ứng dụng (Lấy từ Discord Developer Portal -> General Information -> Application ID)
CLIENT_ID=your_discord_client_id_here

# Guild/Server ID (Tùy chọn: nếu điền thì slash command sẽ cập nhật ngay lập tức cho server này)
# Nếu để trống, slash command sẽ được đăng ký Global (toàn cục)
GUILD_ID=

# Google AI (Gemini) API Key (Lấy từ https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Model Gemini sử dụng (mặc định: gemini-2.5-flash hoặc gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# ID của Role được phép thay đổi System Prompt (/changesys)
# Có thể điền 1 Role ID hoặc nhiều ID cách nhau bằng dấu phẩy
# Lưu ý: Người có quyền Administrator trên server cũng mặc định được phép dùng
ALLOWED_ROLE_ID=your_role_id_here

# Tên Role được phép thay đổi System Prompt (Tùy chọn, dự phòng nếu không dùng ID)
ALLOWED_ROLE_NAME=Bot Manager,Admin
