# ==========================================
# CẤU HÌNH BOT DISCORD & GROQ AI
# ==========================================

# Token của Discord Bot (Lấy từ Discord Developer Portal -> Bot -> Token)
DISCORD_TOKEN=your_discord_bot_token_here

# Client ID của ứng dụng (Lấy từ Discord Developer Portal -> General Information -> Application ID)
CLIENT_ID=your_discord_client_id_here

# Hai hoặc nhiều Server ID để đăng ký lệnh Guild ngay lập tức, cách nhau bằng dấu phẩy.
# Ví dụ: GUILD_IDS=123456789012345678,987654321098765432
# Nếu để trống, lệnh được đăng ký ở chế độ Global cho mọi server.
GUILD_IDS=

# Tương thích ngược với cấu hình Server ID cũ; có thể bỏ trống khi dùng GUILD_IDS.
GUILD_ID=

# Groq API Key (Lấy từ https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Model Groq sử dụng (ví dụ: llama-3.3-70b-versatile, llama-3.1-8b-instant)
GROQ_MODEL=llama-3.3-70b-versatile

# ==========================================
# CẤU HÌNH TURSO DATABASE (Moderation Logs và cấu hình changelog)
# ==========================================
# URL kết nối Database Turso (ví dụ: libsql://my-db-username.turso.io)
# Nếu để trống, bot sẽ tự động fallback sang SQLite cục bộ (data/moderation.db)
TURSO_DATABASE_URL=

# Auth Token lấy từ Turso CLI: turso db tokens create <database-name>
TURSO_AUTH_TOKEN=

# ID của Role được phép thay đổi System Prompt (/changesys)
# Có thể điền 1 Role ID hoặc nhiều ID cách nhau bằng dấu phẩy
# Lưu ý: Người có quyền Administrator trên server cũng mặc định được phép dùng
ALLOWED_ROLE_ID=your_role_id_here

# Tên Role được phép thay đổi System Prompt (Tùy chọn, dự phòng nếu không dùng ID)
ALLOWED_ROLE_NAME=Bot Manager,Admin

# Tùy chọn tắt phản hồi khi người dùng reply tin nhắn của bot (mặc định: true)
# true: bot KHÔNG trả lời khi người dùng reply tin nhắn của bot
# false: bot vẫn trả lời bình thường khi reply
IGNORE_BOT_REPLIES=true
